{
  "name": "binaryscan-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:demo": "vite --host 127.0.0.1 --mode demo",
    "build": "vue-tsc -b && vite build",
    "build:demo": "vue-tsc -b && vite build --mode demo --outDir dist-demo",
    "lint": "eslint . --max-warnings 0",
    "preview:demo": "vite preview --host 127.0.0.1 --outDir dist-demo",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:watch": "vitest"
  },
  "dependencies": {
    "element-plus": "2.11.0",
    "lucide-vue-next": "0.468.0",
    "monaco-editor": "0.52.2",
    "pinia": "3.0.3",
    "vue": "3.5.20",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@playwright/test": "1.62.1",
    "@testing-library/vue": "8.1.0",
    "@types/node": "24.3.0",
    "@vitejs/plugin-vue": "6.0.1",
    "@vue/test-utils": "2.4.6",
    "@vue/tsconfig": "0.8.1",
    "eslint": "9.34.0",
    "eslint-plugin-vue": "10.4.0",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vite": "7.1.3",
    "vitest": "3.2.4",
    "vue-tsc": "3.0.6"
  }
}
